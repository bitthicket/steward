<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BitThicket.Steward.Api.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests.fs" />
    <Compile Include="PersistenceTests.fs" />
    <Compile Include="AuthTests.fs" />
    <Compile Include="ApiKeyTests.fs" />
    <Compile Include="RlsIsolationTests.fs" />
    <Compile Include="AccountRepositoryTests.fs" />
    <Compile Include="CategoryRepositoryTests.fs" />
    <Compile Include="TransactionRepositoryTests.fs" />
    <Compile Include="TransactionMatcherTests.fs" />
    <Compile Include="BudgetRepositoryTests.fs" />
    <Compile Include="BudgetPeriodRepositoryTests.fs" />
    <Compile Include="DataFeedConnectionRepositoryTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit.v3" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="FsUnit.xUnit" Version="7.*" />
    <PackageReference Include="Unquote" Version="7.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BitThicket.Steward.Api\BitThicket.Steward.Api.fsproj" />
  </ItemGroup>

</Project>
