<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Migrations.fs" />
    <Compile Include="TenantContext.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="AccountRepository.fs" />
    <Compile Include="CategoryRepository.fs" />
    <Compile Include="TransactionRepository.fs" />
    <Compile Include="TransactionMatcher.fs" />
    <Compile Include="VaultService.fs" />
    <Compile Include="DataFeedConnectionRepository.fs" />
    <Compile Include="PlaidService.fs" />
    <Compile Include="BudgetRepository.fs" />
    <Compile Include="BudgetPeriodRepository.fs" />
    <Compile Include="Pricing.fs" />
    <Compile Include="BudgetEndpoints.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="PricingWorker.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Falco" Version="5.*" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.*" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.*" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
  </ItemGroup>
</Project>
