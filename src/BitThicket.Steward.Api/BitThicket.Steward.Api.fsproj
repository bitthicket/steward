    <Compile Include="TenantContext.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="AccountRepository.fs" />
    <Compile Include="CategoryRepository.fs" />
    <Compile Include="TransactionRepository.fs" />
    <Compile Include="TransactionMatcher.fs" />
    <Compile Include="ReconciliationRepository.fs" />
    <Compile Include="VaultService.fs" />
    <Compile Include="DataFeedConnectionRepository.fs" />
    <Compile Include="SyncEventRepository.fs" />
    <Compile Include="PlaidService.fs" />
    <Compile Include="AkoyaOAuthService.fs" />
    <Compile Include="BudgetRepository.fs" />
    <Compile Include="BudgetPeriodRepository.fs" />
    <Compile Include="UserPreferencesRepository.fs" />
    <Compile Include="ApiKeyRepository.fs" />
    <Compile Include="FeedHealthRepository.fs" />
    <Compile Include="RemediationAttemptRepository.fs" />
    <Compile Include="Pricing.fs" />
    <Compile Include="BudgetEndpoints.fs" />
    <Compile Include="AccountEndpoints.fs" />
    <Compile Include="ReconciliationEndpoints.fs" />
    <Compile Include="UserPreferencesEndpoints.fs" />
    <Compile Include="ConnectionEndpoints.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="McpServer.fs" />
    <Compile Include="PricingWorker.fs" />
    <Compile Include="FeedHealthWorker.fs" />
    <Compile Include="AkoyaTokenRefreshWorker.fs" />
    <Compile Include="Logging.fs" />
